[sub_resource type="Shader" id="GridShader"]
code = "shader_type spatial;

uniform vec3 color_a : source_color = vec3(0.35, 0.37, 0.4);
uniform vec3 color_b : source_color = vec3(0.28, 0.3, 0.33);
uniform vec3 line_color : source_color = vec3(0.9, 0.9, 0.9);
uniform float cell_size = 4.0;
uniform float line_width = 0.05;

varying vec3 world_pos;

void vertex() {
	world_pos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}

void fragment() {
	vec2 p = world_pos.xz / cell_size;
	vec2 cell = floor(p);
	float checker = mod(cell.x + cell.y, 2.0);
	vec3 col = mix(color_a, color_b, checker);
	// une ligne blanche tous les 10 carreaux (40 m) pour se reperer
	vec2 big = abs(fract(p / 10.0 + 0.5) - 0.5) * 10.0;
	float line = 1.0 - step(line_width, min(big.x, big.y));
	ALBEDO = mix(col, line_color, line);
	ROUGHNESS = 0.9;
}
"

